# ecowitt-monitor settings. Copy to .env and fill in. Restart after changes: pm2 restart ecowitt-monitor --update-env

# One station: the Home Assistant that has it (the core Ecowitt integration) and a long-lived access token from that
# HA (your profile -> Security -> Long-lived access tokens). Read-only use: it reads states and statistics.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# Optional: a name for it (else the console's name), and which station if that HA has several (the start of its
# sensors' unique IDs).
STATION_NAME=
STATION=

# Or several stations, each in its own (or the same) Home Assistant, picked with buttons on the card:
# STATION_1_NAME=Home
# STATION_1_HA_URL=http://192.168.1.10:8123
# STATION_1_HA_TOKEN=
# STATION_2_NAME=Cottage
# STATION_2_HA_URL=http://cottage-ha.example:8123
# STATION_2_HA_TOKEN=
# STATION_2_ID=          (only if that HA has more than one station)

# Home Assistant webhook for alerts (see ha-automation.yaml). Blank: alerts are only listed on the Alerts tab.
HA_WEBHOOK=
# Or/also ntfy (no Home Assistant app needed: the ntfy app, subscribed to a topic with a long random name).
NTFY_URL=
# NTFY_URL=https://ntfy.sh/weather-pick-a-long-random-name
# Only for a protected ntfy server or topic:
NTFY_TOKEN=
# Opened when you tap an ntfy alert, e.g. this monitor's dashboard:
DASHBOARD_URL=

# Sharing with guests: with a password, anyone can look but only you can change alerts (sign in on the Alerts tab).
ADMIN_PASSWORD=

# Port for the dashboard (http://<this machine>:7120/) and the API.
PORT=7120
